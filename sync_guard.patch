+// --------------------------------------------------------------------
+// Sanitizer + safe UI sync (low-stack)
+// --------------------------------------------------------------------
+static void nxSanitize_(String& s) {
+  String out; out.reserve(s.length());
+  for (size_t i = 0; i < s.length(); ++i) {
+    unsigned char c = (unsigned char)s[i];
+    if (c == ' ' || (c >= 32 && c <= 126)) out += (char)c;
+  }
+  s = out;
+}
